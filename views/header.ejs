<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        body{margin: 0;padding: 0 ;color: #18181b;}
        #App{
            display: grid;
            grid-template-columns: 230px 1fr;
            grid-template-areas: 
            'sidebar navbar'
            'sidebar content'
            ;
        }
        .border-shadow{
            border: 1px solid #e4e4e7;
            box-shadow: 0px 1px 3px rgba(0,0,0,0.05),0 1px 2px rgba(0,0,0,0.5);
        }
    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <div id="App">
        <%-include('sidebar')%>
            <div style="display: flex;grid-area: navbar;position: relative;">
                <%-include('navbar')%>
            </div>
            <main style="padding: 50px 30px;min-height: 100vh;
            display: flex;flex-direction: column; grid-area: content;
            gap: 12px;background-color: #f8fafc;">