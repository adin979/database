<%-include('header')%>
<style>
    h2,label,th,td{color: 18181b;font-weight: normal;}
    h2{
        padding: 0;
        margin: 0;
    }
    form{
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .card{
        display: flex;
        flex-direction: column;
        justify-content: space-evenly;
        gap: 12px;
        border: 1px solid #e4e4e7;
        box-shadow: 0px 1px 3px rgba(0,0,0,0.05),0 1px 2px rgba(0,0,0,0.5);
        border-radius: 4px;
        padding: 18px;
        background: #fafafa;
        height: fit-content;
    }
    button{
        width: fit-content;
    }
    input,button{
        border-radius: 2px;
        border: 1px solid #e4e4e7;
        box-shadow: 0 1px 2px rgba(0,0,0,0.2);
    }
    table,td,th{
        border: 1px solid #e4e4e7;
    }
    table{
        border-collapse: collapse;
    }
    thead{
        text-align: left;
    }
    td input,td select{
        width: stretch;
    }
</style>
<div class="card">
    <h2>Create Database</h2>
    <form id="dbForm">
        <label for="dbname">Database</label>
        <input type="text" name="dbname" id="dbname">
        <button type="submit">Create</button>
    </form>
</div>
<div class="card">
    <h2>Create Table</h2>
    <form id="table-form">
        <div style="display: flex;gap: 12px;">
            <label for="tablename">Table Name
                <input type="text" name="tablename" id="tablename">
            </label>
            <label for="colcount">Column Count  
                <input type="number" name="colcount" id="colcount" value="1" style="width: 2rem;">
            </label>
        </div>
        <div style="border: 1px solid #e4e4e7;display: flex;justify-content: end;">
            <button name="confirm" type="button">Confirmasi</button>
        </div>
        <table id="tabelinput">
            <thead >
                <th> name</th>
                <th>type</th>
                <th>req</th>
                <th>uniq</th>
                <th>hash</th>
                <th>pk</th>
                <th>ai</th>
            </thead>
            <tbody class="colinput">
            </tbody>
        </table>
        <button type="submit">Create</button>
    </form>
</div>
<script type="module">
import create from '/scripts/create.js'
create()
</script>
<%-include('footer')%>